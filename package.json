{
  "name": "gs-portfolio",
  "version": "7.1.16",
  "description": "Growth Stats marketing site and blog, built with Next.js and Sanity",
  "author": "Growth Stats (https://growthstats.io)",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run manifest && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "manifest": "sanity manifest extract --path public/admin/static",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config scripts/i18n/vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:export": "sanity exec scripts/i18n/export.ts --",
    "i18n:import": "sanity exec scripts/i18n/import.ts --",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@next/third-parties": "^16.4.5",
    "@portabletext/to-html": "^6.0.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@sanity/code-input": "^7.3.14",
    "@sanity/dashboard": "^6.0.22",
    "@sanity/document-internationalization": "6.2.46",
    "@sanity/icons": "5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/language-filter": "^5.0.23",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/ui": "4.4.10",
    "@sanity/vision": "6.22.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-sanity": "^13.4.0",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.10.2",
    "octokit": "^5.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "resend": "^6.37.0",
    "sanity": "6.22.0",
    "sanity-plugin-internationalized-array": "^5.3.9",
    "sanitypress-utils": "^0.0.8",
    "shiki": "^4.6.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "sanity": "$sanity",
    "@sanity/dashboard": "$@sanity/dashboard"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{md,mdx,css,scss,html,json}": [
      "prettier --write"
    ]
  }
}
